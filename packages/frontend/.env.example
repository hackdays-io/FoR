# Local setup note:
# - copy this file to packages/frontend/.env
# - VITE_PRIVY_APP_ID is required for local login and should use the value shared by the team
# - set VITE_CHAIN_ID=31337 when connecting to the local Hardhat node

# Privy App ID (get from https://console.privy.io or use the value shared by the team)
VITE_PRIVY_APP_ID=your-privy-app-id-here

# Chain ID (31337=Local, 11155111=Sepolia, 8453=Base)
VITE_CHAIN_ID=11155111

# Alchemy API Key (get from https://dashboard.alchemy.com)
VITE_ALCHEMY_KEY=your-alchemy-key-here

# Pimlico API Key (get from https://dashboard.pimlico.io)
VITE_PIMLICO_API_KEY=your-pimlico-api-key-here

# Subgraph URL (leave empty for auto-configuration based on chain ID)
# Local: http://localhost:8000/subgraphs/name/for/localhost
# Sepolia: https://api.goldsky.com/api/public/project_cm5nv64onnxxz01wf8smdgk1e/subgraphs/for-sepolia/0.0.0/gn
# Base: https://api.goldsky.com/api/public/project_cm4r39viziqcd01wo6y96c1r6/subgraphs/for-base/0.0.0/gn
VITE_SUBGRAPH_URL=

# Contract addresses (optional, env が優先。未設定なら chain ID ごとの組み込み定数にフォールバック)
# 設定する場合は両方とも有効な 0x… 形式のアドレスに
VITE_FOR_TOKEN_ADDRESS=
VITE_ROUTER_ADDRESS=

# Namespace API Key (get from https://dev.namespace.ninja)
# アドレスベース / ドメインベースのどちらのキーでも可
NAMESPACE_API_KEY=your-namespace-api-key-here

# ENS 親名（toban と共有。サブネームは <label>.<この値> になる）
NAMESPACE_PARENT_NAME=toban.eth

# Pinata (IPFS) — プロフィール画像アップロードに使用
# JWT / Gateway / Gateway Token は https://app.pinata.cloud から取得
VITE_PINATA_JWT=your-pinata-jwt-here
VITE_PINATA_GATEWAY=your-gateway.mypinata.cloud
VITE_PINATA_GATEWAY_TOKEN=your-pinata-gateway-token-here

# AllowList 追加署名に使う管理者アカウントの秘密鍵
# FoRToken の ADMIN_ROLE を持つアドレスの private key（先頭 0x はあっても無くても可）
# サーバー側 (/api/allowlist/sign) でのみ使用する
ADMIN_PRIVATE_KEY=

# --- MCP サーバー (/api/mcp) ---
# AI エージェント向けの読み取り API。詳細は docs/mcp.md
# 接続に必要な Bearer トークン。未設定だとエンドポイントは 503 を返す（=無効）
MCP_API_KEY=

# 参照するサブグラフの上書き（任意）。未設定なら VITE_SUBGRAPH_URL / チェーン ID から決まる。
# チェーン名・コントラクト・エクスプローラー URL はアプリのビルド設定に従うため、
# 上書きする場合も同じチェーンのサブグラフを指定すること。
MCP_SUBGRAPH_URL=
